APP_NAME=FANORA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fanora
DB_USERNAME=fanora
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@fanora.app"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment gateway
# sandbox | production
PAYMENT_ENV=sandbox
PAYMENT_PROVIDER=null
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_URL=/api/v1/webhooks/payment
PAYMENT_GATEWAY_FEE_RATE=4.99
ASAAS_SANDBOX_URL=https://sandbox.asaas.com/api/v3
ASAAS_PRODUCTION_URL=https://www.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_TIMEOUT=15
ASAAS_CONNECT_TIMEOUT=5

# Platform business rules (configurable, not hardcoded)
FANORA_COMMISSION_RATE=20
FANORA_ALLOWED_SUBSCRIPTION_PRICES=990,1990,2990
FANORA_MIN_SUBSCRIPTION_PRICE=990
FANORA_MAX_SUBSCRIPTION_PRICE=2990

# PWA
PWA_ENABLED=true

VITE_APP_NAME="${APP_NAME}"